{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Control",
  "version": "0.1.0",
  "identifier": "com.kokapuk.remote-control",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Remote Control",
        "width": 800,
        "height": 600,
        "windowEffects": { "effects": ["micaDark"] },
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
