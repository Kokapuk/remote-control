{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Control",
  "mainBinaryName": "Remote Control",
  "version": "0.1.0",
  "identifier": "com.kokapuk.remote-control",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Remote Control",
        "width": 800,
        "height": 600,
        "windowEffects": { "effects": ["micaDark"] },
        "theme": "Dark",
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../client/dist/": "remote_frontend/"
    }
  }
}
